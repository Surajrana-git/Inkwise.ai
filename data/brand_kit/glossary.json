  },
  {
    "id": "T08",
    "approved": "account activity",
    "banned_variants": ["account feed", "money timeline"],
    "note": "Use this for the customer's list of recent account transactions."
  },
  {
    "id": "T09",
    "approved": "in-app support",
    "banned_variants": ["app helpdesk", "Lumora hotline"],
    "note": "Use only when referring to support accessed from within the app."
  },
  {
    "id": "T10",
    "approved": "spending category",
    "banned_variants": ["spend bucket", "expense class"],
