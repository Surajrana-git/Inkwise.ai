  },
  {
    "id": "T06",
    "approved": "transaction notification",
    "banned_variants": ["txn alert", "transaction ping"],
    "note": "Spell out notification; avoid abbreviations."
  },
  {
    "id": "T07",
    "approved": "monthly spending target",
    "banned_variants": ["monthly budget cap", "spend limit"],
