  {
    "id": "T14",
    "approved": "monthly activity statement",
    "banned_variants": ["monthly ledger", "account dossier"],
    "note": "Use this for the downloadable monthly summary of account activity."
  },
  {
    "id": "T15",
    "approved": "eligible customer",
    "banned_variants": ["approved user", "pre-qualified member"],
