  },
  {
    "id": "T04",
    "approved": "transfer",
    "banned_variants": ["money push", "wire action"],
    "note": "Use transfer for moving money between accounts or to another recipient."
  },
  {
    "id": "T05",
    "approved": "scheduled payment",
    "banned_variants": ["auto debit", "standing instruction"],
